# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon key — safe to expose to the browser. All reads go
# through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. Server-side only. Never prefix with
# NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Webhook (/api/tenant/update)
# ---------------------------------------------------------------------------
# Shared secret used to sign and verify incoming webhooks.
# Generate with: openssl rand -hex 32
TENANT_WEBHOOK_SECRET=

# Allow the simpler "Authorization: Bearer <TENANT_WEBHOOK_SECRET>" scheme.
# Off by default: it has no replay or body-integrity protection.
# TENANT_WEBHOOK_ALLOW_BEARER=false

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Tenant to render when the request carries no usable Host header.
DEFAULT_TENANT_DOMAIN=localhost
