 "cues": [
  {
   "from": 0.02,
   "to": 1.42,
   "text": "לקוח מחפש אתכם עכשיו."
  },
  {
   "from": 1.42,
   "to": 2.82,
   "text": "הוא מוצא אתר שעונה לו."
  },
  {
   "from": 2.82,
   "to": 4.29,
   "text": "ואתם בונים אותו בצ׳אט."
  },
  {
   "from": 4.29,
   "to": 5.85,
   "text": "Easy Landing. אתר לעסק, שלא מפספס אף לקוח."
  },
  {
   "from": 5.85,
   "to": 8,
   "text": "שלב 1 מתוך 10: בוחרים תחום. לכל תחום אתר לדוגמה משלו."
  },
  {
   "from": 8,
   "to": 17.06,
   "text": "ארבעה סוגי עסקים"
  },
  {
   "from": 17.06,
   "to": 19.72,
   "text": "בוחרים תחום, והטלפון מתחלף"
  },
  {
   "from": 19.72,
   "to": 21.85,
   "text": "שלב 2 מתוך 10: רואים את האתר לדוגמה. באותה תבנית שתקבלו."
  },
  {
   "from": 21.85,
   "to": 24.07,
   "text": "ככה האתר ייראה ללקוחות שלכם"
  },
  {
   "from": 24.07,
   "to": 25.48,
   "text": "השירותים והמחירים, בטבלה"
  },
  {
   "from": 25.48,
   "to": 28.65,
   "text": "לקוח פותח את הצ׳אט"
  },
  {
   "from": 28.65,
   "to": 32.7,
   "text": "שואל, והלקוח עונה בלחיצה"
  },
  {
   "from": 32.7,
   "to": 36.26,
   "text": "שלב 3 מתוך 10: נכנסים לבונה. שם וטלפון, וזהו."
  },
  {
   "from": 36.26,
   "to": 38.98,
   "text": "שם וטלפון"
  },
  {
   "from": 38.98,
   "to": 40.43,
   "text": "משמאל האתר שלכם. מימין השאלות"
  },
  {
   "from": 40.43,
   "to": 43.24,
   "text": "שלב 4 מתוך 10: בוחרים תבנית. כמה תבניות לכל תחום. האתר מתחלף מיד."
  },
  {
   "from": 43.24,
   "to": 48.14,
   "text": "והאתר מתחלף מיד"
  },
  {
   "from": 48.14,
   "to": 50.94,
   "text": "שלב 5 מתוך 10: בוחרים צבעים. שמונה ערכות לכל תבנית."
  },
  {
   "from": 50.94,
   "to": 54.41,
   "text": "אפשר להחליף גם אחר כך"
  },
  {
   "from": 54.41,
   "to": 57.28,
   "text": "שלב 6 מתוך 10: עונים על כמה שאלות. האתר מתמלא תוך כדי."
  },
  {
   "from": 57.28,
   "to": 58.58,
   "text": "שם העסק"
  },
  {
   "from": 58.58,
   "to": 60.03,
   "text": "אזור וישובים"
  },
  {
   "from": 60.03,
   "to": 63.52,
   "text": "השירותים שלכם"
  },
  {
   "from": 63.52,
   "to": 67.68,
   "text": "מחירים לדוגמה. משאירים או משנים"
  },
  {
   "from": 67.68,
   "to": 68.4,
   "text": "זמן חזרה, שעות, אחריות וכותרת: לוחצים ובוחרים"
  },
  {
   "from": 68.4,
   "to": 72.53,
   "text": "האינסטגרם, הפייסבוק והטיקטוק"
  },
  {
   "from": 72.53,
   "to": 77.62,
   "text": "שלב 7 מתוך 10: מעלים תמונות. שלכם, ושל העבודה."
  },
  {
   "from": 77.62,
   "to": 79.36,
   "text": "בוחרים מהטלפון"
  },
  {
   "from": 79.36,
   "to": 80.99,
   "text": "והן כבר באתר"
  },
  {
   "from": 80.99,
   "to": 83.88,
   "text": "שלב 8 מתוך 10: עוברים על האתר. בדיוק כמו שהוא יעלה."
  },
  {
   "from": 83.88,
   "to": 86.8,
   "text": "גוללים את כל האתר"
  },
  {
   "from": 86.8,
   "to": 89.09,
   "text": "משהו לא יושב? כותבים בצ׳אט"
  },
  {
   "from": 89.09,
   "to": 93.63,
   "text": "שלב 9 מתוך 10: מאשרים ובוחרים חבילה. נוכחות, או נציג AI."
  },
  {
   "from": 93.63,
   "to": 97.82,
   "text": "בוחרים חבילה"
  },
  {
   "from": 97.82,
   "to": 100.7,
   "text": "שלב 10 מתוך 10: משלמים, והאתר באוויר. כתובת, כרטיס, והוא עולה לבד."
  },
  {
   "from": 100.7,
   "to": 103.23,
   "text": "בוחרים כתובת לאתר"
  },
  {
   "from": 103.23,
   "to": 106,
   "text": "המחיר סופי. היום משלמים רק את ההקמה"
  },
  {
   "from": 106,
   "to": 107.42,
   "text": "משלמים בכרטיס, בדף מאובטח"
  },
  {
   "from": 107.42,
   "to": 109.41,
   "text": "האתר עלה לאוויר לבד, תוך דקה"
  },
  {
   "from": 109.41,
   "to": 111.21,
   "text": "ואיך מביאים את הלקוחות הראשונים"
  },
  {
   "from": 111.21,
   "to": 115.63,
   "text": "האתר באוויר, בכתובת שלכם. מותאם לנייד, עם וואטסאפ וחיוג."
  },
  {
   "from": 115.63,
   "to": 121.1,
   "text": "צ׳אט שעונה ללקוחות, בכל שעה. שואל מה צריך, איפה וכמה דחוף."
  },
  {
   "from": 121.1,
   "to": 126.28,
   "text": "הלקוח מצרף תמונה. ומקבל הערכה ראשונית מהמחירון שלכם."
  },
  {
   "from": 126.28,
   "to": 127.54,
   "text": "והפנייה נשמרת"
  },
  {
   "from": 127.54,
   "to": 130.88,
   "text": "מענה אוטומטי בוואטסאפ. מהמספר שלכם, תוך שניות."
  },
  {
   "from": 130.88,
   "to": 133.58,
   "text": "זה מה שהלקוח מקבל, מהמספר שלכם"
  },
  {
   "from": 133.58,
   "to": 134.82,
   "text": "התראה על כל פנייה. עם כפתור ״טיפלתי״, ותזכורת אם עוד לא חזרתם."
  },
  {
   "from": 134.82,
   "to": 137.53,
   "text": "וזה מה שאתם מקבלים"
  },
  {
   "from": 137.53,
   "to": 140.1,
   "text": "עוד לא חזרתם? תזכורת"
  },
  {
   "from": 140.1,
   "to": 145.85,
   "text": "ביקורת בגוגל, באישור שלכם. נשלחת רק כשאתם לוחצים ״כן, לשלוח״."
  },
  {
   "from": 145.85,
   "to": 149.84,
   "text": "צ׳אט AI שעונה מהמחירון. וכשהוא לא יודע, הוא לא ממציא."
  },
  {
   "from": 149.84,
   "to": 152.01,
   "text": "מהמחירון שלכם בלבד"
  },
  {
   "from": 152.01,
   "to": 157.59,
   "text": "כל הפניות בלוח אחד. מי פנה, מה צריך, ומה מחכה לכם."
  },
  {
   "from": 157.59,
   "to": 162.97,
   "text": "סטטיסטיקות, בלי עוגיות. כניסות, פניות והופעות בגוגל."
  },
  {
   "from": 162.97,
   "to": 168.87,
   "text": "קישור לכל רשת וקבוצה. ו־QR להדפסה. רואים מה הביא פניות."
  },
  {
   "from": 168.87,
   "to": 172.3,
   "text": "דוח חודשי בוואטסאפ. כמה נכנסו, כמה פנו, ובכמה טיפלתם."
  },
  {
   "from": 172.3,
   "to": 174.82,
   "text": "ב־1 לכל חודש"
  },
  {
   "from": 174.82,
   "to": 184.16,
   "text": "כותבים ״חירום״, והאתר מתעדכן. גם ״עסוק״ ו״פנוי״, מהוואטסאפ."
  },
  {
   "from": 184.16,
   "to": 188.38,
   "text": "האינסטגרם והטיקטוק, באתר. ומי שמגיע מהרשתות מוצא את האתר."
  },
  {
   "from": 188.38,
   "to": 195.2,
   "text": "דף לכל שירות ולכל אזור. כדי שימצאו אתכם בגוגל."
  },
  {
   "from": 195.2,
   "to": 202.01,
   "text": "שתי חבילות. בלי התחייבות. נוכחות: 1,500 ₪ הקמה, ועוד 150 ₪ לחודש. נציג AI: 2,490 ₪ הקמה, ועוד 290 ₪ לחודש, מחיר השקה נעול. המחירים סופיים. מבטלים מתי שרוצים."
  },
  {
   "from": 202.01,
   "to": 207.333333,
   "text": "אף פנייה לא הולכת לאיבוד. לבנות את האתר שלי: service-pro-web.netlify.app/build"
  }
